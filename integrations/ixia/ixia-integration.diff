+// ── Guardrails (TechEx 2026) ────────────────────────────────────────────────
+
+/** Reviewer decision on a held draft: approve as-is, send an edited text, or reject. */
+export async function reviewLeadAction(formData: FormData) {
+  const ctx = await getContext();
+  if (!ctx) redirect('/login');
+  const id = String(formData.get('id') || '');
+  const action = String(formData.get('action') || '');
+  const text = String(formData.get('text') || '').trim().slice(0, 4000);
+  if (!['approved', 'edited_and_sent', 'rejected'].includes(action)) return;
+  const ws = ctx.workspace;
+  const lead = db().prepare("SELECT * FROM leads WHERE id=? AND workspace_id=? AND review_status='pending'").get(id, ws.id) as any;
+  if (!lead) return;
+  let guard: any = {};
+  try { guard = JSON.parse(lead.guard_json || '{}'); } catch { /* keep empty */ }
+
+  if (action !== 'rejected') {
+    const body = action === 'approved'
+      ? `${(lead.ai_draft || '').trim()}\n\n${disclosure(guard.lang || 'en', ws.name)}`
+      : text;
+    if (!body.trim()) return;
+    if (lead.email) {
+      try {
+        const r = await sendEmail({ to: lead.email, from: ws.from_email || undefined, subject: `Re: your enquiry to ${ws.name}`, text: wrapBody(ws, body) });
+        logEvent(id, ws.id, 'routed', `reviewed reply emailed (${r.via})`);
+      } catch (e: any) { logEvent(id, ws.id, 'routed', `email failed: ${e?.message || e}`); }
+    }
+    db().prepare("UPDATE leads SET review_status=?, ai_reply=?, status=CASE WHEN status IN ('leaking','new') THEN 'responded' ELSE status END WHERE id=?")
+      .run(action === 'approved' ? 'approved' : 'edited', body, id);
+  } else {
+    db().prepare("UPDATE leads SET review_status='rejected' WHERE id=?").run(id);
+  }
+  logEvent(id, ws.id, 'review', `${action.replace(/_/g, ' ')} by ${ctx.user.email}`);
+  try { await audit(ws.id, id, { decision: lead.guard_decision || '', action, actor: ctx.user.email, promptVersion: guard.promptVersion }); } catch { /* non-fatal */ }
+  revalidatePath('/review');
+  revalidatePath('/leads/' + id);
+  revalidatePath('/dashboard');
+}
+
+export async function addKbAction(formData: FormData) {
+  const ctx = await getContext();
+  if (!ctx) redirect('/login');
+  const title = String(formData.get('title') || '').trim().slice(0, 120);
+  const text = String(formData.get('text') || '').trim().slice(0, 1500);
+  if (!title || !text) return;
+  const count = (db().prepare('SELECT COUNT(*) n FROM kb_snippets WHERE workspace_id=?').get(ctx.workspace.id) as any).n;
+  if (count >= 60) return;
+  const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 30) || 'entry';
+  const taken = db().prepare('SELECT 1 FROM kb_snippets WHERE workspace_id=? AND slug=?').get(ctx.workspace.id, slug);
+  db().prepare('INSERT INTO kb_snippets (id,workspace_id,slug,title,text,created_at) VALUES (?,?,?,?,?,?)')
+    .run('kb_' + randomBytes(10).toString('hex'), ctx.workspace.id, taken ? `${slug}_${count + 1}` : slug, title, text, Date.now());
+  revalidatePath('/settings');
+}
+
+export async function deleteKbAction(formData: FormData) {
+  const ctx = await getContext();
+  if (!ctx) redirect('/login');
+  db().prepare('DELETE FROM kb_snippets WHERE id=? AND workspace_id=?').run(String(formData.get('id') || ''), ctx.workspace.id);
+  revalidatePath('/settings');
+}
+
+export async function toggleGuardAction(formData: FormData) {
+  const ctx = await getContext();
+  if (!ctx) redirect('/login');
+  db().prepare('UPDATE workspaces SET guard_enabled=? WHERE id=?').run(formData.get('enabled') ? 1 : 0, ctx.workspace.id);
+  revalidatePath('/settings');
+}
